// Italian Dvorak: a Dvorak-style layout optimised for Italian.
// Generated by `python -m kbeval.export` from keymaps/; do not edit by hand.
// https://github.com/FabioCuccaro/italian_dvorak

default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {
    name[Group1] = "Italian Dvorak v2";

    key <TLDE> { [ backslash   , bar ] };
    key <AE01> { [ 1           , exclam ] };
    key <AE02> { [ 2           , quotedbl ] };
    key <AE03> { [ 3           , sterling ] };
    key <AE04> { [ 4           , dollar ] };
    key <AE05> { [ 5           , percent ] };
    key <AE06> { [ 6           , ampersand ] };
    key <AE07> { [ 7           , slash ] };
    key <AE08> { [ 8           , parenleft ] };
    key <AE09> { [ 9           , parenright ] };
    key <AE10> { [ 0           , equal ] };
    key <AE11> { [ apostrophe  , question ] };
    key <AE12> { [ igrave      , asciicircum ] };
    key <AD01> { [ k           , K ] };
    key <AD02> { [ f           , F ] };
    key <AD03> { [ apostrophe  , question    , EuroSign ] };
    key <AD04> { [ q           , Q ] };
    key <AD05> { [ egrave      , eacute ] };
    key <AD06> { [ b           , B ] };
    key <AD07> { [ d           , D ] };
    key <AD08> { [ s           , S ] };
    key <AD09> { [ m           , M ] };
    key <AD10> { [ j           , J ] };
    key <AD11> { [ x           , X           , bracketleft , braceleft ] };
    key <AD12> { [ plus        , asterisk    , bracketright, braceright ] };
    key <AC01> { [ u           , U ] };
    key <AC02> { [ e           , E ] };
    key <AC03> { [ i           , I ] };
    key <AC04> { [ a           , A ] };
    key <AC05> { [ o           , O ] };
    key <AC06> { [ c           , C ] };
    key <AC07> { [ t           , T ] };
    key <AC08> { [ l           , L ] };
    key <AC09> { [ n           , N ] };
    key <AC10> { [ r           , R           , at ] };
    key <AC11> { [ dead_grave  , dead_acute  , numbersign ] };
    key <BKSL> { [ ugrave      , section ] };
    key <LSGT> { [ less        , greater ] };
    key <AB01> { [ w           , W ] };
    key <AB02> { [ z           , Z ] };
    key <AB03> { [ y           , Y ] };
    key <AB04> { [ period      , colon ] };
    key <AB05> { [ comma       , semicolon ] };
    key <AB06> { [ p           , P ] };
    key <AB07> { [ g           , G ] };
    key <AB08> { [ v           , V ] };
    key <AB09> { [ h           , H ] };
    key <AB10> { [ minus       , underscore ] };

    include "level3(ralt_switch)"
};
